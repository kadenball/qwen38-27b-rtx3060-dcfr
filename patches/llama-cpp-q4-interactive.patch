+#if defined(__AVX2__)
+#define IQ4XS_MULTI(NQ) \
+static void iq4_xs_multi_##NQ(int n, float * s, size_t bs, const block_iq4_xs * x, const char * vy, size_t by) { \
+    const __m128i values = _mm_loadu_si128((const __m128i *) kvalues_iq4nl); \
+    const __m128i mask = _mm_set1_epi8(0x0f); \
+    const block_q8_K * y[NQ]; \
+    __m256 accum[NQ]; \
+    for (int j = 0; j < NQ; ++j) { y[j] = (const block_q8_K *) (vy + j * by); accum[j] = _mm256_setzero_ps(); } \
+    for (int block = 0; block < n / QK_K; ++block) { \
+        __m256i sum[NQ]; \
+        for (int j = 0; j < NQ; ++j) sum[j] = _mm256_setzero_si256(); \
+        uint16_t sh = x[block].scales_h; \
+        for (int ib = 0; ib < QK_K / 32; ib += 2) { \
+            const __m128i bits1 = _mm_loadu_si128((const __m128i *) (x[block].qs + ib * 16)); \
+            const __m128i bits2 = _mm_loadu_si128((const __m128i *) (x[block].qs + (ib + 1) * 16)); \
+            const __m256i q1 = MM256_SET_M128I( \
+                _mm_shuffle_epi8(values, _mm_and_si128(_mm_srli_epi16(bits1, 4), mask)), \
+                _mm_shuffle_epi8(values, _mm_and_si128(bits1, mask))); \
+            const __m256i q2 = MM256_SET_M128I( \
+                _mm_shuffle_epi8(values, _mm_and_si128(_mm_srli_epi16(bits2, 4), mask)), \
+                _mm_shuffle_epi8(values, _mm_and_si128(bits2, mask))); \
+            const int16_t ls1 = ((x[block].scales_l[ib / 2] & 0xf) | ((sh << 4) & 0x30)) - 32; \
+            const int16_t ls2 = ((x[block].scales_l[ib / 2] >> 4) | ((sh << 2) & 0x30)) - 32; \
+            sh >>= 4; \
+            for (int j = 0; j < NQ; ++j) { \
+                const __m256i v1 = _mm256_loadu_si256((const __m256i *) (y[j][block].qs + ib * 32)); \
+                const __m256i v2 = _mm256_loadu_si256((const __m256i *) (y[j][block].qs + (ib + 1) * 32)); \
