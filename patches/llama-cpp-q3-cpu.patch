+
+// Reuse IQ3 grid/sign/scale decoding across a small speculative token batch.
+// Keep each query's integer sums and FP accumulation order identical to dot1.
+void ggml_vec_dot_iq3_xxs_q8_K_multi(int n, float * s, size_t bs, const void * vx, const void * vy, size_t by, int nq);
+#if defined(__AVX2__)
+#define IQ3XXS_MULTI(NQ) \
+static void iq3_xxs_multi_##NQ(int n, float * s, size_t bs, const block_iq3_xxs * x, const char * vy, size_t by) { \
+    const uint64_t * signs64 = (const uint64_t *) keven_signs_q2xs; \
+    const block_q8_K * y[NQ]; \
+    __m256 accum[NQ]; \
+    for (int j = 0; j < NQ; ++j) { y[j] = (const block_q8_K *) (vy + j * by); accum[j] = _mm256_setzero_ps(); } \
+    for (int i = 0; i < n / QK_K; ++i) { \
+        __m256i sum1[NQ], sum2[NQ]; \
+        for (int j = 0; j < NQ; ++j) { sum1[j] = _mm256_setzero_si256(); sum2[j] = _mm256_setzero_si256(); } \
+        for (int ib = 0; ib < QK_K / 32; ib += 2) { \
+            const uint8_t * q = x[i].qs + ib * 8; \
+            const __m256i grid1 = _mm256_set_epi32(iq3xxs_grid[q[7]], iq3xxs_grid[q[6]], iq3xxs_grid[q[5]], iq3xxs_grid[q[4]], \
+                                                  iq3xxs_grid[q[3]], iq3xxs_grid[q[2]], iq3xxs_grid[q[1]], iq3xxs_grid[q[0]]); \
+            q += 8; \
+            const __m256i grid2 = _mm256_set_epi32(iq3xxs_grid[q[7]], iq3xxs_grid[q[6]], iq3xxs_grid[q[5]], iq3xxs_grid[q[4]], \
+                                                  iq3xxs_grid[q[3]], iq3xxs_grid[q[2]], iq3xxs_grid[q[1]], iq3xxs_grid[q[0]]); \
+            uint32_t aux[2]; \
+            memcpy(aux, x[i].qs + QK_K / 4 + ib * 4, sizeof(aux)); \
+            const __m256i signs1 = _mm256_set_epi64x(signs64[(aux[0] >> 21) & 127], signs64[(aux[0] >> 14) & 127], \
+                                                    signs64[(aux[0] >> 7) & 127], signs64[aux[0] & 127]); \
+            const __m256i signs2 = _mm256_set_epi64x(signs64[(aux[1] >> 21) & 127], signs64[(aux[1] >> 14) & 127], \
+                                                    signs64[(aux[1] >> 7) & 127], signs64[aux[1] & 127]); \
+            const __m256i scale1 = _mm256_set1_epi16(2 * (aux[0] >> 28) + 1); \
+            const __m256i scale2 = _mm256_set1_epi16(2 * (aux[1] >> 28) + 1); \
+            for (int j = 0; j < NQ; ++j) { \
+                const __m256i v1 = _mm256_loadu_si256((const __m256i *) (y[j][i].qs + ib * 32)); \
+                const __m256i v2 = _mm256_loadu_si256((const __m256i *) (y[j][i].qs + (ib + 1) * 32)); \
+                sum1[j] = _mm256_add_epi32(sum1[j], _mm256_madd_epi16(_mm256_maddubs_epi16(grid1, _mm256_sign_epi8(v1, signs1)), scale1)); \
+                sum2[j] = _mm256_add_epi32(sum2[j], _mm256_madd_epi16(_mm256_maddubs_epi16(grid2, _mm256_sign_epi8(v2, signs2)), scale2)); \
+            } \
+        } \
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d); \
+        for (int j = 0; j < NQ; ++j) \
+            accum[j] = _mm256_fmadd_ps(_mm256_set1_ps(d * y[j][i].d), _mm256_cvtepi32_ps(_mm256_add_epi32(sum1[j], sum2[j])), accum[j]); \
+    } \
+    for (int j = 0; j < NQ; ++j) s[j * bs] = 0.25f * hsum_float_8(accum[j]); \
+}
+IQ3XXS_MULTI(1)
+IQ3XXS_MULTI(2)
+IQ3XXS_MULTI(3)
+IQ3XXS_MULTI(4)
+IQ3XXS_MULTI(5)
+IQ3XXS_MULTI(6)
+#undef IQ3XXS_MULTI
+#endif
+
+void ggml_vec_dot_iq3_xxs_q8_K_multi(int n, float * s, size_t bs, const void * vx, const void * vy, size_t by, int nq) {
+    GGML_ASSERT(n % QK_K == 0 && nq >= 1 && nq <= 6);
+#if defined(__AVX2__)
+    switch (nq) {
+#define IQ3XXS_CASE(NQ) case NQ: iq3_xxs_multi_##NQ(n, s, bs, vx, vy, by); return;
+        IQ3XXS_CASE(1) IQ3XXS_CASE(2) IQ3XXS_CASE(3) IQ3XXS_CASE(4) IQ3XXS_CASE(5) IQ3XXS_CASE(6)
+#undef IQ3XXS_CASE
+    }
+#endif
+    for (int q = 0; q < nq; ++q)
+        ggml_vec_dot_iq3_xxs_q8_K(n, s + q * bs, 0, vx, 0, (const char *) vy + q * by, 0, 1);
 }
 
