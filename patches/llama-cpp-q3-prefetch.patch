+static bool prefetch_alias_safe(ggml_backend_sched_t sched, int split_id, const ggml_tensor * weight, uint64_t * reasons, bool allocation_bounds = false) {
+    const auto & graph = sched->splits[split_id].graph;
+    const auto reject = [&](int reason) { reasons[reason]++; return false; };
+    if (weight->view_src || !ggml_is_contiguous(weight)) return reject(0);
+    const auto root = [](const ggml_tensor * tensor) {
+        while (tensor && tensor->view_src) tensor = tensor->view_src;
+        return tensor;
+    };
+    // The original destination stays unfilled, so no later split may read it.
+    for (int s = split_id + 1; s < sched->n_splits; ++s) {
+        const auto & future = sched->splits[s].graph;
+        for (int n = 0; n < future.n_nodes; ++n) {
+            if (root(future.nodes[n]) == weight) return reject(7);
+            for (int i = 0; i < GGML_MAX_SRC; ++i) {
+                if (root(future.nodes[n]->src[i]) == weight) return reject(7);
+            }
+        }
+    }
+    bool used = false;
+    const uintptr_t start = (uintptr_t) weight->data;
+    const auto footprint = [&](const ggml_tensor * tensor) {
+        if (allocation_bounds && tensor->buffer) {
+            return ggml_backend_buft_get_alloc_size(ggml_backend_buffer_get_type(tensor->buffer), tensor);
+        }
+        return ggml_nbytes(tensor) + 4096;
+    };
+    const size_t bytes = footprint(weight);
+    const auto overlaps = [&](const ggml_tensor * tensor) {
+        if (!tensor || !tensor->data || tensor == weight) return false;
+        if (allocation_bounds) tensor = root(tensor);
+        const uintptr_t other = (uintptr_t) tensor->data;
+        return start <= other ? other - start < bytes : start - other < footprint(tensor);
+    };
+    for (int n = 0; n < graph.n_nodes; ++n) {
+        const ggml_tensor * node = graph.nodes[n];
+        if (root(node) == weight) return reject(2);
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            const ggml_tensor * src = node->src[i];
+            if (src && src != weight && root(src) == weight) return reject(4);
+            if (overlaps(src)) {
+                // A prior graph output owns its value, not the old weight bytes.
+                bool produced = false;
+                for (int p = 0; p < n; ++p) {
+                    if (graph.nodes[p] == root(src) && graph.nodes[p]->op != GGML_OP_NONE) produced = true;
+                }
+                if (!produced) return reject(3);
+            }
+            if (src == weight) {
+                if (node->op != GGML_OP_MUL_MAT || i != 0) return reject(5);
+                used = true;
+            }
+        }
+    }
+    return used ? true : reject(6);
+}
