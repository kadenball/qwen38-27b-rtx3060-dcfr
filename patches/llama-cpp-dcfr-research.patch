+            H, n_tokens, sq1, sq2, sv1, sv2, sb1, sb2, neqk1_magic, scale, n_factors, main_nodes); break;
+        case 32: ggml_cuda_kernel_launch(gated_delta_net_tree_cuda<32>, launch_params,
+            q, k, v, g, beta, state, replay_factors, replay_path, parent, dst, state_out, factors,
+            H, n_tokens, sq1, sq2, sv1, sv2, sb1, sb2, neqk1_magic, scale, n_factors, main_nodes); break;
+        case 64: ggml_cuda_kernel_launch(gated_delta_net_tree_cuda<64>, launch_params,
+            q, k, v, g, beta, state, replay_factors, replay_path, parent, dst, state_out, factors,
+            H, n_tokens, sq1, sq2, sv1, sv2, sb1, sb2, neqk1_magic, scale, n_factors, main_nodes); break;
+        case 128: ggml_cuda_kernel_launch(gated_delta_net_tree_cuda<128>, launch_params,
+            q, k, v, g, beta, state, replay_factors, replay_path, parent, dst, state_out, factors,
+            H, n_tokens, sq1, sq2, sv1, sv2, sb1, sb2, neqk1_magic, scale, n_factors, main_nodes); break;
+        default: GGML_ABORT("fatal error");
     }
