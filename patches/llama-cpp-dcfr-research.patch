+    const int64_t state_offset = h_idx * S_v * S_v + col * S_v;
+    const float * state_in = curr_state + state_offset;
+    float * state_out = state + h_idx * S_v * S_v + col * S_v;
+    float * attn_data = dst + h_idx * S_v;
+
+#pragma unroll
+    for (int r = 0; r < rows_per_lane; ++r) {
+        s_shard[r] = state_in[r * warp_size + lane];
+    }
+
+    const int replay_count = replay_path[0];
+    const int64_t head_factor_size = 1 + 2*S_v;
+    const int64_t factor_size = head_factor_size * H;
