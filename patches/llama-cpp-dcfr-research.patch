+llama_ubatch llama_batch_allocr::split_tree(uint32_t n_ubatch) {
+    std::vector<int32_t> idxs;
+    for (uint32_t i = 0; i < used.size() && idxs.size() < n_ubatch; ++i) {
+        if (!used[i]) {
+            idxs.push_back(i);
+        }
+    }
+
+    if (idxs.empty()) {
+        return {};
+    }
+
+    for (const int32_t idx : idxs) {
+        GGML_ASSERT(!used[idx]);
+        used[idx] = true;
+        ++n_used;
+    }
+
+    llama_ubatch result = ubatch_add(idxs, 1, true);
+    result.b_tree = true;
+    result.data->tree_parent.assign(idxs.size(), -1);
+
+    for (size_t i = 1; i < idxs.size(); ++i) {
+        const int32_t child = idxs[i];
+        for (size_t j = i; j-- > 0;) {
+            const int32_t candidate = idxs[j];
+            if (batch.pos[candidate] + 1 == batch.pos[child] &&
+                    (seq_set[candidate] & seq_set[child]).any()) {
+                result.data->tree_parent[i] = (int32_t) j;
+                break;
+            }
+        }
+        GGML_ASSERT(result.data->tree_parent[i] >= 0 && "verification tree must be prefix-closed");
+    }
+
+    uint32_t main_nodes = 0;
+    while (main_nodes < idxs.size() && seq_set[idxs[main_nodes]].test(0)) {
+        ++main_nodes;
+    }
+    GGML_ASSERT(main_nodes > 0);
+
+    result.tree_parent = result.data->tree_parent.data();
+    result.tree_main_nodes = main_nodes;
+    return result;
+}
