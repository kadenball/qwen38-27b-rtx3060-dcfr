+        int64_t sq1, int64_t sq2, int64_t sv1, int64_t sv2, int64_t sb1, int64_t sb2,
+        int64_t neqk1, float scale, int n_factors, int main_nodes, cudaStream_t stream) {
+    GGML_ASSERT(n_tokens <= 32 && main_nodes <= n_tokens);
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const int num_warps = 4;
+    const dim3 grid_dims(H, 1, (S_v + num_warps - 1) / num_warps);
