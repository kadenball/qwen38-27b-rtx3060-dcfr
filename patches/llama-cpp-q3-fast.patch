+#pragma once
+
+#include <cuda.h>
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+// Private single-device prototype. Call outside graph capture with the owning context current.
+class rw_cuda_sparse_buffer {
+    CUdeviceptr base = 0;
+    CUmemAllocationProp prop = {};
+    size_t logical_size;
+    size_t reserve_size;
+    size_t page_size;
+    size_t mapped_bytes = 0;
+    size_t budget;
+    unsigned char clear_value = 0;
+    std::vector<unsigned char> mapped;
+
+public:
+    static void cuda_check(CUresult result) {
+        if (result == CUDA_SUCCESS) return;
+        const char * message = nullptr;
+        cuGetErrorString(result, &message);
+        throw std::runtime_error(message ? message : "CUDA sparse memory error");
+    }
+
+    rw_cuda_sparse_buffer(int device, size_t bytes, size_t max_physical = SIZE_MAX) : logical_size(bytes), budget(max_physical) {
+        prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id = device;
+        size_t minimum;
+        cuda_check(cuMemGetAllocationGranularity(&minimum, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM));
+        page_size = ((2 * 1024 * 1024 + minimum - 1) / minimum) * minimum;
+        if (!bytes || bytes > SIZE_MAX - page_size) throw std::runtime_error("Invalid sparse reservation size");
+        reserve_size = ((bytes + page_size - 1) / page_size) * page_size;
+        mapped.resize(reserve_size / page_size, 0);
+        cuda_check(cuMemAddressReserve(&base, reserve_size, page_size, 0, 0));
+    }
+
+    rw_cuda_sparse_buffer(const rw_cuda_sparse_buffer &) = delete;
+    rw_cuda_sparse_buffer & operator=(const rw_cuda_sparse_buffer &) = delete;
+
+    ~rw_cuda_sparse_buffer() {
+        if (!base) return;
+        cuCtxSynchronize();
+        for (size_t i = 0; i < mapped.size(); ++i) {
+            if (mapped[i]) cuMemUnmap(base + i * page_size, page_size);
+        }
+        cuMemAddressFree(base, reserve_size);
+    }
+
+    CUdeviceptr data() const { return base; }
+    size_t size() const { return logical_size; }
+    size_t committed() const { return mapped_bytes; }
+
+    bool ensure(size_t offset, size_t bytes, void (*reclaim)(size_t) = nullptr) {
+        if (offset > logical_size || bytes > logical_size - offset) return false;
+        if (!bytes) return true;
+        const size_t begin = offset / page_size;
+        const size_t end = (offset + bytes + page_size - 1) / page_size;
+        size_t missing = 0;
+        for (size_t i = begin; i < end; ++i) missing += !mapped[i];
+        if (!missing) return true;
+        if (missing > (budget - mapped_bytes) / page_size) return false;
+        if (reclaim) reclaim(missing * page_size);
+        cuda_check(cuCtxSynchronize());
+        std::vector<size_t> added;
+        added.reserve(missing);
+        CUmemAccessDesc access = {};
+        access.location = prop.location;
+        access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        try {
+            for (size_t i = begin; i < end; ++i) {
+                if (mapped[i]) continue;
+                CUmemGenericAllocationHandle handle;
+                const CUresult allocated = cuMemCreate(&handle, page_size, &prop, 0);
+                if (allocated != CUDA_SUCCESS) cuda_check(allocated);
+                const CUresult result = cuMemMap(base + i * page_size, page_size, 0, handle, 0);
+                cuMemRelease(handle);
+                cuda_check(result);
+                added.push_back(i);
+                cuda_check(cuMemSetAccess(base + i * page_size, page_size, &access, 1));
+                cuda_check(cuMemsetD8(base + i * page_size, clear_value, page_size));
+            }
+        } catch (const std::runtime_error &) {
+            cuCtxSynchronize();
+            for (size_t i : added) cuMemUnmap(base + i * page_size, page_size);
+            return false;
+        }
+        for (size_t i : added) mapped[i] = 1;
+        mapped_bytes += added.size() * page_size;
+        return true;
+    }
+
+    void clear(unsigned char value) {
+        cuda_check(cuCtxSynchronize());
+        for (size_t i = 0; i < mapped.size(); ++i) {
+            if (mapped[i]) cuda_check(cuMemsetD8(base + i * page_size, value, page_size));
+        }
+        cuda_check(cuCtxSynchronize());
+        clear_value = value;
+    }
+};
