+template<class T>
+static __device__ __forceinline__ float rw_fold_dot(const T * x,const block_q8_1 * y,int k,int q) {
+    if constexpr (std::is_same_v<T,block_iq3_xxs>) return vec_dot_iq3_xxs_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_iq3_s>) return vec_dot_iq3_s_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_iq2_s>) return vec_dot_iq2_s_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_iq2_xxs>) return vec_dot_iq2_xxs_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_iq2_xs>) return vec_dot_iq2_xs_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_q2_K>) return vec_dot_q2_K_q8_1(x,y,k,q);
+    if constexpr (std::is_same_v<T,block_iq4_xs>) return vec_dot_iq4_xs_q8_1(x,y,k,q);
+}
+
+template<class T,int R,bool row_first,int B>
+__global__ __launch_bounds__(32,B) void rw_folded(const T * x,const block_q8_1 * y,float * out,int kb,int rows) {
+    constexpr int vdr=std::is_same_v<T,block_q2_K>?VDR_Q2_K_Q8_1_MMVQ:
+        std::is_same_v<T,block_iq4_xs>?VDR_IQ4_XS_Q8_1_MMVQ:VDR_IQ2_XXS_Q8_1_MMVQ;
+    constexpr int qi=std::is_same_v<T,block_q2_K>?QI2_K:
+        std::is_same_v<T,block_iq4_xs>?QI4_XS:std::is_same_v<T,block_iq2_xs>?QI2_XS:
+        std::is_same_v<T,block_iq3_xxs>?QI3_XXS:std::is_same_v<T,block_iq3_s>?QI3_S:
+        std::is_same_v<T,block_iq2_s>?QI2_S:QI2_XXS;
+    constexpr int lanes=qi/vdr;
+    const int tid=threadIdx.x,row=blockIdx.x*R;
+    float sums[2][5][R]={};
+    for (int k=tid/lanes;k<kb;k+=64/lanes) {
+#pragma unroll
+        for (int part=0;part<2;++part) {
+            const int kx=k+part*32/lanes;
+            if (kx>=kb) continue;
+            if constexpr (row_first) {
+#pragma unroll
+                for (int i=0;i<R;++i) {
+#pragma unroll
+                    for (int j=0;j<5;++j) sums[part][j][i]+=rw_fold_dot(x,y+j*kb*8+kx*8,(row+i)*kb+kx,vdr*(tid%lanes));
+                }
+            } else {
+#pragma unroll
+                for (int j=0;j<5;++j) {
+#pragma unroll
+                    for (int i=0;i<R;++i) sums[part][j][i]+=rw_fold_dot(x,y+j*kb*8+kx*8,(row+i)*kb+kx,vdr*(tid%lanes));
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int j=0;j<5;++j) {
+#pragma unroll
+        for (int i=0;i<R;++i) {
+            const float value=warp_reduce_sum<32>(sums[0][j][i]+sums[1][j][i]);
